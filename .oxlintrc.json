{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "unicorn/no-useless-spread": "off"
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "packages/vscode-extension/media",
    "aidlc",
    "packages/vscode-extension/tests/fixtures/doctor/captured",
    "docs",
    ".claude",
    ".cursor",
    "install.ts"
  ],
  "overrides": [
    {
      "files": [
        "packages/core-utils/src/**",
        "packages/reader-core/src/**",
        "packages/shared-types/src/**",
        "packages/docs-bridge/src/**",
        "packages/mcp-server/src/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "importNames": [
                  "writeFile",
                  "writeFileSync",
                  "appendFile",
                  "appendFileSync",
                  "mkdir",
                  "mkdirSync",
                  "rm",
                  "rmSync",
                  "rmdir",
                  "rmdirSync",
                  "unlink",
                  "unlinkSync",
                  "rename",
                  "renameSync",
                  "copyFile",
                  "copyFileSync",
                  "truncate",
                  "truncateSync",
                  "symlink",
                  "symlinkSync",
                  "link",
                  "linkSync",
                  "chmod",
                  "chmodSync",
                  "chown",
                  "chownSync",
                  "utimes",
                  "utimesSync",
                  "createWriteStream"
                ],
                "message": "reader-core, docs-bridge and mcp-server are read-only (BR-RC-1 / BR-DB-5 / BR-MS-1 / S-RC-1 / S-DB-1 / S-MS-1 / NFR-1). Only readFile/readdir/stat/realpath/open('r') are allowed."
              },
              {
                "name": "node:fs/promises",
                "importNames": [
                  "writeFile",
                  "appendFile",
                  "mkdir",
                  "rm",
                  "rmdir",
                  "unlink",
                  "rename",
                  "copyFile",
                  "truncate",
                  "symlink",
                  "link",
                  "chmod",
                  "chown",
                  "utimes"
                ],
                "message": "reader-core, docs-bridge and mcp-server are read-only (BR-RC-1 / BR-DB-5 / BR-MS-1 / S-RC-1 / S-DB-1 / S-MS-1 / NFR-1). Only readFile/readdir/stat/realpath/open('r') are allowed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/api-core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "importNames": [
                  "writeFile",
                  "writeFileSync",
                  "appendFile",
                  "appendFileSync",
                  "mkdir",
                  "mkdirSync",
                  "rm",
                  "rmSync",
                  "rmdir",
                  "rmdirSync",
                  "unlink",
                  "unlinkSync",
                  "rename",
                  "renameSync",
                  "copyFile",
                  "copyFileSync",
                  "truncate",
                  "truncateSync",
                  "symlink",
                  "symlinkSync",
                  "link",
                  "linkSync",
                  "chmod",
                  "chmodSync",
                  "chown",
                  "chownSync",
                  "utimes",
                  "utimesSync",
                  "createWriteStream"
                ],
                "message": "BR-DS-1 / S-DS-3: handlers/answer-writer.ts is the only module in api-core allowed to write. Route the write through it."
              },
              {
                "name": "node:fs/promises",
                "importNames": [
                  "writeFile",
                  "appendFile",
                  "mkdir",
                  "rm",
                  "rmdir",
                  "unlink",
                  "rename",
                  "copyFile",
                  "truncate",
                  "symlink",
                  "link",
                  "chmod",
                  "chown",
                  "utimes"
                ],
                "message": "BR-DS-1 / S-DS-3: handlers/answer-writer.ts is the only module in api-core allowed to write. Route the write through it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/api-core/src/handlers/answer-writer.ts",
        "packages/api-core/src/ai-cli/scratch.ts",
        "packages/api-core/src/customization/storage.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/dashboard-server/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "importNames": [
                  "writeFile",
                  "writeFileSync",
                  "appendFile",
                  "appendFileSync",
                  "mkdir",
                  "mkdirSync",
                  "rm",
                  "rmSync",
                  "rmdir",
                  "rmdirSync",
                  "unlink",
                  "unlinkSync",
                  "rename",
                  "renameSync",
                  "copyFile",
                  "copyFileSync",
                  "truncate",
                  "truncateSync",
                  "symlink",
                  "symlinkSync",
                  "link",
                  "linkSync",
                  "chmod",
                  "chmodSync",
                  "chown",
                  "chownSync",
                  "utimes",
                  "utimesSync",
                  "createWriteStream"
                ],
                "message": "BR-DS-1 / S-DS-3: dashboard-server must not write — route through api-core answer-writer."
              },
              {
                "name": "node:fs/promises",
                "importNames": [
                  "writeFile",
                  "appendFile",
                  "mkdir",
                  "rm",
                  "rmdir",
                  "unlink",
                  "rename",
                  "copyFile",
                  "truncate",
                  "symlink",
                  "link",
                  "chmod",
                  "chown",
                  "utimes"
                ],
                "message": "BR-DS-1 / S-DS-3: dashboard-server must not write — route through api-core answer-writer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/vscode-extension/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "importNames": ["writeFile", "writeFileSync", "appendFile", "appendFileSync"],
                "message": "vscode-extension: .mcp.json merge only — route through mcp-register.ts"
              },
              {
                "name": "node:fs/promises",
                "importNames": ["writeFile", "appendFile"],
                "message": "vscode-extension: .mcp.json merge only — route through mcp-register.ts"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/vscode-extension/src/mcp-register.ts",
        "packages/vscode-extension/src/native-setup.ts",
        "packages/vscode-extension/src/cli-management.ts",
        "packages/vscode-extension/src/native-harness-install.ts",
        "packages/vscode-extension/src/native-harness-merge.ts",
        "packages/vscode-extension/src/native-plugin-inputs.ts",
        "packages/vscode-extension/src/native-workspace-lock.ts",
        "packages/vscode-extension/src/workflows-repair.ts",
        "packages/vscode-extension/src/workflows-repair-files.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/dashboard/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@base-ui/**",
                  "@radix-ui/**",
                  "@shadcn/react",
                  "@shadcn/react/**",
                  "class-variance-authority"
                ],
                "message": "The dashboard's UI is Mantine behind src/shared/ui. Add or extend a part there."
              }
            ]
          }
        ],
        "react/no-danger": "error",
        "react/no-danger-with-children": "error",
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              { "pattern": "^CardContent$", "allow": ["layout", "spacing"] },
              { "pattern": "^CardHeader$", "allow": ["layout", "spacing"] },
              { "pattern": "^CardFooter$", "allow": ["layout", "spacing"] },
              { "pattern": "^CardTitle$", "allow": ["layout", "spacing"] },
              { "pattern": "^CardDescription$", "allow": ["layout", "typography"] },
              { "pattern": "^Tabs$", "allow": ["layout", "spacing"] },
              { "pattern": "^TabsPanel$", "allow": ["layout", "spacing"] },
              { "pattern": "^FieldGroup$", "allow": ["layout", "spacing"] },
              { "pattern": "^Accordion$", "allow": ["layout", "spacing"] },
              { "pattern": "^AccordionTrigger$", "allow": ["layout", "spacing"] },
              { "pattern": "^HoverCardContent$", "allow": ["layout", "spacing"] },
              { "pattern": "^DropdownMenuContent$", "allow": ["layout", "spacing"] },
              { "pattern": "^DropdownMenuGroup$", "allow": ["layout", "spacing"] },
              { "pattern": "^DialogHeader$", "allow": ["layout", "spacing"] }
            ]
          }
        ],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": [
          "error",
          {
            "allow": [
              "viewer",
              "viewer__*",
              "cell",
              "cell__*",
              "cell--*",
              "matrix",
              "matrix__*",
              "chip",
              "chip__*",
              "unit-cell",
              "live",
              "live__*",
              "customization-*",
              "markdown-editor",
              "app-home"
            ]
          }
        ],
        "shadcn/require-static-classes": "error"
      },
      "jsPlugins": ["@shadcn/lint"]
    },
    {
      "files": ["packages/dashboard/src/shared/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": [
        "packages/dashboard/src/**/*.test.ts",
        "packages/dashboard/src/**/*.test.tsx",
        "packages/dashboard/tests/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@testing-library/react",
                "message": "Import from @tests/render.tsx so the render has a MantineProvider."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@base-ui/**",
                  "@radix-ui/**",
                  "@shadcn/react",
                  "@shadcn/react/**",
                  "class-variance-authority"
                ],
                "message": "The dashboard's UI is Mantine behind src/shared/ui. Add or extend a part there."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/dashboard/tests/render.tsx", "packages/dashboard/tests/setup.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
