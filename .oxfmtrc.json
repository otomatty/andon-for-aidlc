{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "**/node_modules/",
    "**/dist/",
    "coverage/",
    ".git/",
    ".claude/",
    ".cursor/",
    "install.ts",
    ".codex/",
    ".agents/",
    "aidlc/",
    ".worktrees/",
    "packages/*/aidlc/",
    "packages/*/tests/",
    "packages/vscode-extension/media/",
    "packages/vscode-extension/tests/fixtures/doctor/captured/",
    "docs/guide/",
    "docs/reference/",
    "docs/harness-engineering/",
    "bun.lock",
    "packages/docs-bridge/data/artifact-map.json",
    "docs/official-docs.index.json",
    "**/*.md",
    "!/README.md",
    "!/packages/README.md",
    "!/packages/*/README.md",
    "!/docs/guides/**/*.md",
    "!/docs/maintenance/**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "!/.github/**/*.yml",
    "!/.github/**/*.yaml",
    "**/*.mdx",
    "**/*.toml",
    "**/*.html",
    "**/*.htm",
    "**/*.vue",
    "**/*.svelte",
    "**/*.graphql",
    "**/*.gql",
    "**/*.scss",
    "**/*.less",
    "**/*.json5",
    "**/*.hbs"
  ]
}
