{
  "name": "@andon/dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Bun server for the dashboard SPA. Owns the system's only write path (AnswerWriter).",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aidlc-dashboard": "./src/cli.ts"
  },
  "scripts": {
    "dashboard": "bun run ./src/cli.ts"
  },
  "dependencies": {
    "@andon/api-core": "workspace:*",
    "@andon/docs-bridge": "workspace:*",
    "@andon/reader-core": "workspace:*",
    "@andon/shared-types": "workspace:*"
  }
}
