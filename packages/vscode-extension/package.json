{
  "name": "aidlc-guide",
  "displayName": "Andon for AI-DLC",
  "description": "Visualize aidlc-workflows state and artifacts inside VS Code / Cursor.",
  "version": "0.1.0",
  "publisher": "aidlc",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/otomatty/andon-for-aidlc.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:aidlc/",
    "workspaceContains:.claude/skills/aidlc",
    "workspaceContains:.claude/skills/aidlc-guide-docs",
    "workspaceContains:.cursor/skills/aidlc-guide-docs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aidlc-guide.open",
        "title": "Open",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.setup",
        "title": "Setup",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.showWelcome",
        "title": "Show Welcome",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.showWhatsNew",
        "title": "Show What's New",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.openPlugins",
        "title": "Open Plugins",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.registerMcp",
        "title": "Register MCP",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.checkUpdate",
        "title": "Check for Updates",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.installWorkflows",
        "title": "Install Workflows",
        "category": "Andon"
      },
      {
        "command": "aidlc-guide.updateWorkflows",
        "title": "Update Workflows",
        "category": "Andon"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "bunx vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@aidlc-guide/api-core": "workspace:*",
    "@aidlc-guide/core-utils": "workspace:*",
    "@aidlc-guide/official-docs": "workspace:*",
    "@aidlc-guide/reader-core": "workspace:*",
    "@aidlc-guide/shared-types": "workspace:*",
    "jsonc-parser": "^3.3.1"
  }
}
