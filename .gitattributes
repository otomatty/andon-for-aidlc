# Keep working-tree line endings as LF on every OS so Biome format checks
# match Linux/macOS CI (Windows runners otherwise convert to CRLF).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
