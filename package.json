{
  "name": "andon-for-aidlc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run check:docs-index && bun run check:plugins && bun run check:plugins-catalog && bun run check:workflows-compatibility && bun run test:coverage && bun run check:audit-shards && bun run audit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "bun run lint:oxlint && bun run lint:canonical-classes && bun run lint:canonical-paths && bun run lint:workflows",
    "lint:oxlint": "oxlint",
    "lint:canonical-classes": "bun scripts/check-canonical-classes.ts",
    "lint:canonical-paths": "bun scripts/check-canonical-paths.ts",
    "lint:workflows": "bun scripts/lint-workflows.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/dashboard && tsc --noEmit -p packages/vscode-extension",
    "check:docs-index": "bun scripts/build-docs-index.ts --check",
    "build:plugins-catalog": "bun scripts/build-bundled-plugins.ts",
    "check:plugins-catalog": "bun scripts/build-bundled-plugins.ts --check",
    "check:plugins": "bun .claude/tools/aidlc-plugin-validate.ts plugins/focus && bun .claude/tools/aidlc-plugin-test.ts plugins/focus --install . --harness claude",
    "check:workflows-compatibility": "bun scripts/check-workflows-compatibility.ts",
    "check:audit-shards": "bun scripts/check-audit-shards.ts",
    "audit": "bun audit",
    "build:dashboard": "vite build packages/dashboard",
    "build:dashboard:webview": "vite build packages/dashboard --mode webview",
    "build:official-docs-media": "bun scripts/copy-official-docs-media.ts",
    "build:docs-index": "bun scripts/build-docs-index.ts",
    "build:artifact-map": "bun scripts/build-artifact-map.ts",
    "build:extension": "bun run build:dashboard:webview && bun run build:official-docs-media && bun run --cwd packages/vscode-extension build && bun scripts/build-bundled-plugins.ts --check --out packages/vscode-extension/dist/plugins",
    "package:extension": "bun run build:extension && bun run --cwd packages/vscode-extension package"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0",
    "@hono/node-server": "^2.1.3",
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.2",
    "nanoid": "^3.3.17",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "source-map-js": "^1.2.2",
    "undici": "^8.11.2"
  }
}
